# --- WebDAV connection ---
# Base URL of the WebDAV server (including scheme), e.g. https://cloud.example.com/remote.php/webdav
WEBDAV_HOSTNAME=https://cloud.example.com/remote.php/webdav
WEBDAV_LOGIN=your-username
WEBDAV_PASSWORD=your-password

# Connection timeout in seconds (optional, default: 30)
WEBDAV_TIMEOUT=30

# Verify the server's TLS certificate. Only set to false for trusted local test
# servers with self-signed certificates. (optional, default: true)
WEBDAV_VERIFY_SSL=true

# --- Application ---
# Absolute path to the directory whose sub-folders can be backed up.
BACKUP_BASE_DIR=/absolute/path/to/backup/base

# Flask secret key used to sign the session cookie (flash messages).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value
